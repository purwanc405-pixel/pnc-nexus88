# PostgreSQL (Neon free tier OR local Docker Postgres)
# Neon: copy connection string from console.neon.tech (use pooled + ?sslmode=require for serverless)
# Docker: docker run --name pnc-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=pnc_nexus -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Session / JWT secret — generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-rahasia-acak"

# Stub notifikasi operator (mailto / WA link di UI — tanpa SMTP)
OPS_NOTIFY_EMAIL="ops@pnc.nexus"
OPS_NOTIFY_WA="6281200000000"

# 0 = local HTTP; 1 = production HTTPS (Vercel)
COOKIE_SECURE=0
